{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "focus-visible-state-is-ack-gated",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/CompanionViewModel.kt",
      "pattern": "pendingAction = FocusPendingAction\\.Start[\\s\\S]*?result\\.isSuccess && pendingAction != null[\\s\\S]*?applyAcknowledged\\(pendingAction\\)",
      "message": "Focus must not display a running phone timer until X3 acknowledges StartSession."
    },
    {
      "id": "focus-ack-reducer-clears-pending-state",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/FocusSessionStore.kt",
      "pattern": "applyAcknowledged[\\s\\S]*?FocusPendingAction\\.Start[\\s\\S]*?phase = FocusPhase\\.Running[\\s\\S]*?pendingAction = null[\\s\\S]*?FocusPendingAction\\.Stop[\\s\\S]*?phase = FocusPhase\\.Setup",
      "message": "Focus applied phases must be reduced from acknowledged commands and clear pending state."
    },
    {
      "id": "usb-commands-refresh-device-activity",
      "type": "required_pattern",
      "path": "firmware/src/main.cpp",
      "pattern": "recognizedCommand[\\s\\S]*?if \\(!recognizedCommand\\) return[\\s\\S]*?lastActivityAtMs = millis\\(\\)[\\s\\S]*?powerManager\\.setPowerSaving\\(false\\)",
      "message": "USB commands must restore full-speed processing and extend the shared inactivity deadline."
    },
    {
      "id": "sleep-final-sync-is-power-interruptible",
      "type": "required_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "deepSleepWakeRequested_[\\s\\S]*?wakeRequested && wakeRequested\\(\\)[\\s\\S]*?WakeRequiresRestart[\\s\\S]*?WakeCancelled",
      "message": "A new physical Power press must interrupt the bounded final-sync lifecycle or request a safe restart after teardown begins."
    },
    {
      "id": "sleep-transition-wake-is-edge-latched",
      "type": "required_pattern",
      "path": "firmware/src/main.cpp",
      "pattern": "sleepTransitionWakeLatched[\\s\\S]*?attachInterrupt[\\s\\S]*?FALLING[\\s\\S]*?finalizeForDeepSleep\\(1200, 2100, sleepTransitionWakeRequested\\)[\\s\\S]*?powerManager\\.startDeepSleep\\(gpio, sleepTransitionWakeRequested\\)",
      "message": "Power wake must remain edge-latched from final sync through the hardware deep-sleep commit."
    },
    {
      "id": "sleep-frame-completes-before-final-sync",
      "type": "required_pattern",
      "path": "firmware/src/activities/ActivityManager.cpp",
      "pattern": "goToSleep\\(bool fromTimeout\\)[\\s\\S]*?loop\\(false\\)[\\s\\S]*?requestUpdateAndWait\\(\\)[\\s\\S]*?requestUpdateAndWait\\(\\)[\\s\\S]*?requestedUpdate = false",
      "message": "The Sleeping frame must physically complete before its visible cancellation and final-sync window begins."
    },
    {
      "id": "cancelled-sleep-consumes-wake-gesture",
      "type": "required_pattern",
      "path": "firmware/src/main.cpp",
      "pattern": "restoreAfterCancelledSleep[\\s\\S]*?waitForPowerRelease\\(\\)[\\s\\S]*?gpio\\.update\\(\\)[\\s\\S]*?delay\\(10\\)[\\s\\S]*?gpio\\.update\\(\\)",
      "message": "A wake tap that cancels sleep must be fully released and debounced before ordinary Power handling resumes."
    },
    {
      "id": "cancelled-sleep-requests-clean-refresh",
      "type": "required_pattern",
      "path": "firmware/src/main.cpp",
      "pattern": "restoreAfterCancelledSleep[\\s\\S]*?display\\.requestCleanRefresh\\(\\)[\\s\\S]*?activityManager\\.requestUpdateAndWait\\(\\)",
      "message": "Cancelling a visible sleep frame must synchronously replace it with one clean destination render."
    },
    {
      "id": "instant-wake-skips-released-recovery-settle",
      "type": "required_pattern",
      "path": "firmware/src/main.cpp",
      "pattern": "PowerButton && rawPowerButtonPressed\\(\\)[\\s\\S]*?while \\(rawPowerButtonPressed\\(\\) && millis\\(\\) - settleStart < 500\\)",
      "message": "An already-released instant wake must not pay the recovery-combination hold window."
    },
    {
      "id": "android-wrapper-requires-pushed-source",
      "type": "required_pattern",
      "path": "scripts/build-xtraordinary-app.ps1",
      "pattern": "assert-pushed-source\\.ps1[\\s\\S]*?& \\$sourceCheck[\\s\\S]*?& \\$policyCheck",
      "message": "Android compilation must reject source that is not committed and pushed first."
    },
    {
      "id": "firmware-wrapper-requires-pushed-source",
      "type": "required_pattern",
      "path": "scripts/build-x3-firmware.ps1",
      "pattern": "assert-pushed-source\\.ps1[\\s\\S]*?& \\$sourceCheck[\\s\\S]*?& \\$policyCheck",
      "message": "Firmware compilation must reject source that is not committed and pushed first."
    },
    {
      "id": "pushed-source-gate-verifies-remote-head",
      "type": "required_pattern",
      "path": "scripts/assert-pushed-source.ps1",
      "pattern": "status --porcelain=v1[\\s\\S]*?rev-parse '@\\{u\\}'[\\s\\S]*?ls-remote --exit-code[\\s\\S]*?Push before compiling",
      "message": "The provenance gate must verify a clean tree and the exact local, upstream, and remote commit."
    },
    {
      "id": "canonical-android-build",
      "type": "required_pattern",
      "path": "AGENTS.md",
      "pattern": "scripts/build-xtraordinary-app\\.ps1",
      "message": "AGENTS.md must require the canonical Android build wrapper."
    },
    {
      "id": "canonical-firmware-build",
      "type": "required_pattern",
      "path": "AGENTS.md",
      "pattern": "scripts/build-x3-firmware\\.ps1",
      "message": "AGENTS.md must require the canonical firmware build wrapper."
    },
    {
      "id": "android-wrapper-runs-policy-gate",
      "type": "required_pattern",
      "path": "scripts/build-xtraordinary-app.ps1",
      "pattern": "check-engineering-policies\\.ps1",
      "message": "The Android wrapper must run the engineering policy gate before Gradle."
    },
    {
      "id": "firmware-wrapper-runs-policy-gate",
      "type": "required_pattern",
      "path": "scripts/build-x3-firmware.ps1",
      "pattern": "check-engineering-policies\\.ps1",
      "message": "The firmware wrapper must run the engineering policy gate before PlatformIO."
    },
    {
      "id": "generic-interactive-coordinator-exists",
      "type": "required_file",
      "path": "app/src/main/java/com/xteink/companion/data/InteractiveTransportCoordinator.kt",
      "message": "Interactive transport must use the shared owner coordinator."
    },
    {
      "id": "generic-interactive-coordinator-tested",
      "type": "required_file",
      "path": "app/src/test/java/com/xteink/companion/data/InteractiveTransportCoordinatorTest.kt",
      "message": "The shared interactive transport coordinator needs lifecycle tests."
    },
    {
      "id": "generic-coordinator-has-owner-set",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/data/InteractiveTransportCoordinator.kt",
      "pattern": "linkedSetOf<InteractiveTransportOwner>",
      "message": "Interactive transport ownership must support multiple concurrent callers."
    },
    {
      "id": "generic-coordinator-has-reconnect-replay",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/data/InteractiveTransportCoordinator.kt",
      "pattern": "shouldApplyLease\\(capabilitiesSequence",
      "message": "Interactive transport must replay its lease for a fresh protocol session."
    },
    {
      "id": "generic-coordinator-has-no-feature-names",
      "type": "forbidden_pattern",
      "path": "app/src/main/java/com/xteink/companion/data/InteractiveTransportCoordinator.kt",
      "pattern": "(?i)\\b(passes?|tickets?|focus|settings?|firmware|books?)\\b",
      "message": "The shared coordinator must not know feature names."
    },
    {
      "id": "generic-contract-has-no-feature-names",
      "type": "forbidden_pattern",
      "path": "app/src/main/java/com/xteink/companion/data/InteractiveTransportContract.kt",
      "pattern": "(?i)\\b(passes?|tickets?|focus|settings?|firmware|books?)\\b",
      "message": "The shared timing contract must not know feature names."
    },
    {
      "id": "transaction-uses-shared-transport",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/CompanionViewModel.kt",
      "pattern": "withInteractiveTransport\\(TicketTransferOwner\\)",
      "message": "Ticket transfer must use the reusable transaction-scoped transport primitive."
    },
    {
      "id": "firmware-clears-session-lease",
      "type": "required_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "onClientDisconnected\\(\\)[\\s\\S]*?interactiveLeaseUntilMs_ = 0",
      "message": "Firmware must clear an interactive lease when its GATT owner disconnects."
    },
    {
      "id": "flash-preserves-app-offset",
      "type": "required_pattern",
      "path": "firmware/platformio.ini",
      "pattern": "(?m)^board_upload\\.offset_address\\s*=\\s*0x10000\\s*$",
      "message": "Application-only firmware output must retain the 0x10000 app offset."
    },
    {
      "id": "firmware-wrapper-does-not-erase-bonds",
      "type": "forbidden_pattern",
      "path": "scripts/build-x3-firmware.ps1",
      "pattern": "(?i)erase[_-]?(flash|all)|erase.*nvs",
      "message": "The canonical firmware build must not erase NVS or Bluetooth bond data."
    },
    {
      "id": "radio-policy-separates-discovery-and-connection",
      "type": "required_pattern",
      "path": "protocol/src/main/kotlin/com/xteink/companion/protocol/Payloads.kt",
      "pattern": "standbyIntervalSeconds[\\s\\S]*?connectedIntervalMs",
      "message": "Radio policy must keep disconnected standby discovery separate from connected cadence."
    },
    {
      "id": "firmware-uses-bounded-standby-pulses",
      "type": "required_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "STANDBY_PULSE_DURATION_MS[\\s\\S]*?updateStandbyAdvertising",
      "message": "Low-power standby must use bounded advertising pulses instead of continuous 1-4 second advertising."
    },
    {
      "id": "firmware-does-not-recouple-standby-and-connection",
      "type": "forbidden_pattern",
      "path": "firmware/src/companion/CompanionService.h",
      "pattern": "slowAdvertisingIntervalUnits",
      "message": "Disconnected advertising and the connected interval must not share the old field."
    },
    {
      "id": "firmware-advertises-radio-policy-v2",
      "type": "required_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "SET_RADIO_POLICY v2 separates standby discovery",
      "message": "Firmware must advertise support before Android sends the separated policy payload."
    },
    {
      "id": "android-capability-gates-radio-policy-v2",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/CompanionViewModel.kt",
      "pattern": "radioPolicyVersion < 2",
      "message": "Android must not claim separated standby values are synchronized to legacy firmware."
    },
    {
      "id": "standby-policy-is-documented",
      "type": "required_pattern",
      "path": "docs/x3-power-sync-flow.md",
      "pattern": "30, 60, or 120 seconds",
      "message": "The canonical power flow must document sparse standby check-ins."
    },
    {
      "id": "interactive-lifecycle-documented",
      "type": "required_file",
      "path": "docs/interactive-transport-lifecycle.md",
      "message": "The reusable interactive transport lifecycle must be documented."
    },
    {
      "id": "standby-chip-uses-applied-device-policy",
      "type": "required_pattern",
      "path": "firmware/src/activities/home/HomeActivity.cpp",
      "pattern": "standbyAdvertisingIntervalMs\\(\\)",
      "message": "Home must derive its standby delay from the applied firmware policy, not copied UI text."
    },
    {
      "id": "firmware-idle-clock-is-c3-supported",
      "type": "required_pattern",
      "path": "firmware/lib/hal/HalPowerManager.h",
      "pattern": "LOW_POWER_FREQ\\s*=\\s*20",
      "message": "ESP32-C3 idle power saving must use its supported 20 MHz XTAL/2 floor, never the ESP32-only 10 MHz divider."
    },
    {
      "id": "firmware-clock-rejection-is-not-retried",
      "type": "required_pattern",
      "path": "firmware/lib/hal/HalPowerManager.cpp",
      "pattern": "rejectedFrequencyMhz == targetFrequency[\\s\\S]*?return",
      "message": "A deterministic clock-configuration rejection must not be retried on every main-loop iteration."
    },
    {
      "id": "runtime-freeze-trace-is-rtc-retained",
      "type": "required_pattern",
      "path": "firmware/src/RuntimeTrace.cpp",
      "pattern": "RTC_NOINIT_ATTR RetainedTrace[\\s\\S]*?printSnapshot\\(output, \"PREVIOUS\"[\\s\\S]*?printSnapshot\\(output, \"ACTIVE\"",
      "message": "Hardware freeze diagnostics must survive a reset without writing SD or NVS in the main loop."
    },
    {
      "id": "companion-radio-stops-before-deep-sleep",
      "type": "required_pattern",
      "path": "firmware/src/main.cpp",
      "pattern": "goToSleep\\(fromTimeout\\)[\\s\\S]*?finalizeForDeepSleep\\(1200, 2100, sleepTransitionWakeRequested\\)",
      "message": "The truthful sleep frame must render before bounded final sync and BLE controller teardown."
    },
    {
      "id": "deep-sleep-does-not-reopen-radio",
      "type": "forbidden_pattern",
      "path": "firmware/src/main.cpp",
      "pattern": "syncBeforeSleep|resumeFastRadio",
      "message": "Entering sleep must never reopen Bluetooth; durable phone work replays after the next wake."
    },
    {
      "id": "companion-radio-teardown-preserves-bonds",
      "type": "required_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "finalizeForDeepSleep\\(uint32_t syncWindowMs, uint32_t timeoutMs,[\\s\\S]*?WakeRequestProbe wakeRequested\\)[\\s\\S]*?xTaskCreate[\\s\\S]*?resumeFastRadio\\(\\)[\\s\\S]*?NimBLEDevice::deinit\\(false\\)[\\s\\S]*?millis\\(\\) - startedAt\\) < timeoutMs",
      "message": "Final sync and deep-sleep BLE teardown must preserve bonds and keep every vendor call behind a hard deadline."
    },
    {
      "id": "final-sync-cannot-replace-sleep-frame",
      "type": "required_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "if \\(!deepSleepPreparing_ && ticketShowPending_[\\s\\S]*?if \\(persisted && !deepSleepPreparing_\\) refreshHomeIfVisible\\(\\)",
      "message": "Commands accepted during final sync must not replace the already-rendered Sleeping frame."
    },
    {
      "id": "sleep-deadline-does-not-stop-radio-before-render",
      "type": "forbidden_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "if \\(elapsed >= companionSleepAfterMs_\\)[\\s\\S]{0,500}?advertising_->stop\\(\\)",
      "message": "The ordinary loop must not call synchronous BLE stop at the sleep deadline before the Sleeping frame renders."
    },
    {
      "id": "instant-power-wake-bypasses-boot-debounce",
      "type": "required_pattern",
      "path": "firmware/lib/hal/HalGPIO.cpp",
      "pattern": "shortPressAllowed \\|\\| requiredDurationMs == 0",
      "message": "A zero-duration power policy must accept the GPIO wake cause even when a fast tap has ended before boot debounce."
    },
    {
      "id": "runtime-trace-is-x3-only",
      "type": "required_pattern",
      "path": "firmware/src/RuntimeTrace.cpp",
      "pattern": "#ifdef ENABLE_X3_COMPANION[\\s\\S]*?RTC_NOINIT_ATTR RetainedTrace",
      "message": "X3 freeze tracing must not add retained state or per-loop writes to unrelated firmware environments."
    },
    {
      "id": "build-version-git-uses-local-safe-directory",
      "type": "required_pattern",
      "path": "firmware/scripts/git_branch.py",
      "pattern": "safe_directory = [\\s\\S]*?'git', '-c', f'safe.directory=\\{safe_directory\\}'",
      "message": "Version generation must use a checkout-local Git ownership override rather than producing unknown or mutating global configuration."
    },
    {
      "id": "build-version-generated-state-is-not-tracked-source",
      "type": "required_pattern",
      "path": "firmware/.gitignore",
      "pattern": "lib/BuildVersion/BuildVersion\\.generated\\.inc",
      "message": "Per-build version state must stay generated and must not overwrite the pushed source checkpoint."
    },
    {
      "id": "standby-advertising-restart-restores-full-clock",
      "type": "required_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "requiresFullClock\\(\\) const[\\s\\S]*?standbyPulseStartDue\\(\\)[\\s\\S]*?bool CompanionService::standbyPulseStartDue\\(\\) const[\\s\\S]*?millis\\(\\) - standbyPulseStartedAtMs_[\\s\\S]*?if \\(standbyPulseStartDue\\(\\)\\)[\\s\\S]*?advertising_->start\\(\\)",
      "message": "A due standby advertising restart must restore full CPU speed before entering the synchronous NimBLE start path."
    },
    {
      "id": "firmware-version-does-not-invalidate-all-objects",
      "type": "forbidden_pattern",
      "path": "firmware/platformio.ini",
      "pattern": "-DCROSSPOINT_VERSION",
      "message": "Firmware versions must be generated into one translation unit; a global version define forces a full seven-minute rebuild for every candidate."
    },
    {
      "id": "quick-resume-makes-sleep-explicit",
      "type": "required_pattern",
      "path": "firmware/src/activities/boot_sleep/SleepActivity.cpp",
      "pattern": "renderLastScreenSleepScreen\\(\\)[\\s\\S]*?STR_SLEEPING[\\s\\S]*?STR_POWER_ON_HINT",
      "message": "Quick Resume must visibly distinguish sleep from the retained awake screen and explain the power-button wake action."
    },
    {
      "id": "radio-policy-invalidates-home-generically",
      "type": "required_pattern",
      "path": "firmware/src/companion/CompanionService.cpp",
      "pattern": "persistRadioPolicy\\(\\)[\\s\\S]*?refreshHomeIfVisible\\(\\)",
      "message": "An acknowledged radio-policy change must invalidate Home through the reusable UI bridge."
    },
    {
      "id": "ticket-formats-share-android-hierarchy",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/components/TicketContent.kt",
      "pattern": "UnifiedPassBody\\(",
      "message": "Matrix and linear ticket formats must share one Android information hierarchy."
    },
    {
      "id": "oem-stock-source-is-distinct",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/data/FirmwareReleaseRepository.kt",
      "pattern": "FirmwareSource\\.XteinkStock[\\s\\S]*?XT V5\\.1\\.6 EN[\\s\\S]*?49926e09526a0201688ea6ac1936a8e62588f66dcd06297f2a011114ede42525",
      "message": "The OEM XTEINK stock source must remain distinct and checksum-pinned."
    },
    {
      "id": "usb-setup-reset-is-nvs-bounded",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/data/UsbEspFlasher.kt",
      "pattern": "NvsOffset = 0x9000[\\s\\S]*?NvsSize = 0x5000",
      "message": "USB setup reset must remain bounded to the X3 NVS partition."
    },
    {
      "id": "usb-reconnect-state-is-explicit",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/data/UsbEspFlasher.kt",
      "pattern": "ReconnectRequired[\\s\\S]*?Disconnect and reconnect X3 USB to continue",
      "message": "A post-flash USB disappearance must preserve explicit disconnect/reconnect guidance."
    },
    {
      "id": "ui-decision-workflow-is-documented",
      "type": "required_pattern",
      "path": "docs/ui-decision-workflow.md",
      "pattern": "## Mandatory sequence[\\s\\S]*?## Definition of done[\\s\\S]*?## Prohibited shortcuts",
      "message": "UI work must retain the structured research, hierarchy, state, and render-verification workflow."
    },
    {
      "id": "ui-surfaces-have-render-evidence",
      "type": "ui_surface_evidence",
      "path": "docs/ui-surface-evidence.json",
      "message": "Every registered UI surface must keep default and adaptive screenshot evidence."
    },
    {
      "id": "settings-does-not-delegate-google-to-setup",
      "type": "forbidden_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/components/SharedComponents.kt",
      "pattern": "Run setup again to opt in",
      "message": "Settings must own Google backup connection instead of replaying setup."
    },
    {
      "id": "onboarding-uses-finished-illustrations",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/components/SetupScreen.kt",
      "pattern": "onboarding_welcome[\\s\\S]*?onboarding_library[\\s\\S]*?onboarding_device",
      "message": "The three onboarding pages must keep the coordinated finished illustration set."
    },
    {
      "id": "transport-blockers-outrank-reconnecting",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/ConnectionPolicy.kt",
      "pattern": "blocker == LinkBlocker\\.BluetoothOff[\\s\\S]*?blocker == LinkBlocker\\.NearbyPermissionRequired[\\s\\S]*?blocker == LinkBlocker\\.BluetoothUnavailable[\\s\\S]*?reconnecting",
      "message": "Known Android transport blockers must be presented before the generic reconnecting state."
    },
    {
      "id": "foreground-reconnect-gap-is-bounded",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/ConnectionPolicy.kt",
      "pattern": "if \\(appForeground\\) return ForegroundReconnectGapMs[\\s\\S]*?ForegroundReconnectGapMs = 500L[\\s\\S]*?BackgroundReconnectBackoffMs",
      "message": "Foreground pending-work recovery must avoid a long no-scan gap while retaining bounded background backoff."
    },
    {
      "id": "foreground-retry-power-boundary-is-documented",
      "type": "required_pattern",
      "path": "docs/x3-power-sync-flow.md",
      "pattern": "## Foreground reconnect and battery boundary[\\s\\S]*?Merely leaving the app open is not persistent work[\\s\\S]*?do not renew the X3 interactive lease",
      "message": "The canonical power policy must keep faster phone recovery separate from X3 power ownership."
    },
    {
      "id": "usb-availability-drains-pending-work",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/CompanionViewModel.kt",
      "pattern": "usb\\.deviceDetected\\) drainPendingUsbWork\\(\\)[\\s\\S]*?fun onAppForegrounded\\(\\)[\\s\\S]*?drainPendingUsbWork\\(\\)[\\s\\S]*?private fun drainPendingUsbWork\\(\\)[\\s\\S]*?resumePendingBookUploadIfPossible\\(\\)",
      "message": "Durable USB queues must drain through one reusable lifecycle boundary on attachment and foreground return."
    },
    {
      "id": "usb-book-transfer-has-phase-logging",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/data/UsbBookTransfer.kt",
      "pattern": "begin ack[\\s\\S]*?progress file=[\\s\\S]*?commit ack[\\s\\S]*?failed phase=[\\s\\S]*?LogTag = \"XteinkUsbBook\"",
      "message": "USB book transfer must retain phase, offset, and throughput diagnostics for physical failures."
    },
    {
      "id": "usb-command-rx-fits-max-envelope",
      "type": "required_pattern",
      "path": "firmware/src/main.cpp",
      "pattern": "USB_COMMAND_RX_BUFFER_BYTES = companion::MAX_PACKET_BYTES \\* 2 \\+ 64[\\s\\S]*?setRxBufferSize\\(USB_COMMAND_RX_BUFFER_BYTES\\)[\\s\\S]*?usbCommandRxBufferBytes != USB_COMMAND_RX_BUFFER_BYTES",
      "message": "The X3 CDC RX queue must hold a full hex-expanded companion envelope and report allocation failure."
    },
    {
      "id": "selected-firmware-card-does-not-intercept-action",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/components/DeviceConnectionSheet.kt",
      "pattern": "onSelect = if \\(source == selectedSource\\)[\\s\\S]*?null[\\s\\S]*?else[\\s\\S]*?onSelectSource\\(source\\)",
      "message": "A selected firmware card must delegate taps to its nested install action instead of reopening source selection."
    },
    {
      "id": "usb-maintenance-has-exclusive-ownership",
      "type": "required_pattern",
      "path": "app/src/main/java/com/xteink/companion/ui/CompanionViewModel.kt",
